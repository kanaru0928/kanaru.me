<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="utf-8">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=M+PLUS+2:wght@400;800&family=Noto+Color+Emoji&display=swap');

    :root {
      --color-base: #eff1f5;
      --color-primary: #8839ef;
      --color-text: #4c4f69;
      --color-overlay-0: #9ca0b0;
      --color-subtext-0: #6c6f85;
      --color-surface-0: #ccd0da;
      --color-pink: #ea76cb;
      --color-blue: #1e66f5;
    }

    * {
      box-sizing: border-box;
      margin: 0;
    }

    body {
      width: <%=it.width %>px;
      height: <%=it.height %>px;
      padding: 5em;
      display: flex;
      gap: 4rem;
      background:
        radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--color-primary) 25%, transparent), transparent 45%),
        radial-gradient(circle at 85% 100%, color-mix(in srgb, var(--color-pink) 20%, transparent), transparent 40%),
        radial-gradient(circle at 0% 100%, color-mix(in srgb, var(--color-blue) 15%, transparent), transparent 40%),
        var(--color-base);
      color: var(--color-text);
      font-family: "M PLUS 2", "Noto Color Emoji", sans-serif;
      font-optical-sizing: auto;
    }

    .main-container {
    }

    .title {
      font-size: 4rem;
      margin-bottom: 1rem;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      -webkit-line-clamp: 3;
      font-weight: 800;
    }

    .bar {
      background-color: var(--color-primary);
      margin-bottom: 1rem;
      height: 0.5rem;
      width: 24rem;
      border-radius: 10000rem;
    }

    .title-container {}

    .eyecatch-container {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;

      .eyecatch-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .eyecatch-emoji {
        font-size: 12rem;
        line-height: 1;
      }
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;

      .tag {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        list-style: none;
        padding: 0.25rem 1rem;
        border-radius: 10000rem;
        border: solid 1px var(--color-surface-0);
        color: var(--color-subtext-0);
        font-size: 1.1rem;
      }
    }

    .texts-container {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      flex: 2;
    }

    .avatar-container {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .avatar-image {
      width: 3rem;
      height: 3rem;
      overflow: hidden;
      border-radius: 10000rem;
    }

    .avatar-text {
      font-size: 1.5rem;
    }

    .footer {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .from-text {
      font-size: 1.3rem;
      color: var(--color-subtext-0);
    }
  </style>
</head>

<body>
  <% if (it.eyecatchImage || it.eyecatchEmoji) { %>
    <div class="eyecatch-container">
      <% if (it.eyecatchImage) { %>
        <img class="eyecatch-image" src="<%= it.eyecatchImage %>" alt="">
        <% } else { %>
          <span class="eyecatch-emoji">
            <%= it.eyecatchEmoji %>
          </span>
          <% } %>
    </div>
    <% } %>
      <div class="texts-container">
        <div></div>
        <div class="title-container">
          <h1 class="title">
            <%= it.title %>
          </h1>
          <div class="bar"></div>
          <div class="tags">
            <% it.tags.forEach(function(tag){ %>
              <li class="tag">
                <svg width="1em" height="1em" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round" class="lucide lucide-hash preview-icon">
                  <line x1="4" x2="20" y1="9" y2="9" />
                  <line x1="4" x2="20" y1="15" y2="15" />
                  <line x1="10" x2="8" y1="3" y2="21" />
                  <line x1="16" x2="14" y1="3" y2="21" />
                </svg>
                <%= tag %>
              </li>
              <% }) %>
          </div>
        </div>
        <div class="footer">
          <div class="avatar-container">
            <img src="https://r2.kanaru.me/icon.jpeg" alt="" class="avatar-image">
            <p class="avatar-text">
              Kanaru
            </p>
          </div>
          <div class="from-text">
            kanaru.me
          </div>
        </div>
      </div>
</body>

</html>
