<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<style>
	* { box-sizing: border-box; margin: 0; }
	body {
		width: <%= it.width %>px;
		height: <%= it.height %>px;
		padding: 80px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		background: #1d232a;
		color: #ffffff;
		font-family: "Hiragino Sans", "Noto Sans JP", sans-serif;
	}
	.title {
		font-size: 64px;
		font-weight: 700;
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.footer {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		font-size: 32px;
	}
	.tags { display: flex; flex-wrap: wrap; gap: 16px; color: #a6adbb; }
	.site { font-weight: 700; }
</style>
</head>
<body>
	<h1 class="title"><%= it.title %></h1>
	<div class="footer">
		<div class="tags">
			<% for (const tag of it.tags) { %>
			<span class="tag">#<%= tag %></span>
			<% } %>
		</div>
		<div class="site">kanaru.me</div>
	</div>
</body>
</html>
